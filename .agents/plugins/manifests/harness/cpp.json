{
  "schema_version": 1,
  "plugin": "tj-agents/cpp",
  "source_roots": [
    ".agents/cpp/skills",
    ".agents/cpp/learning",
    ".agents/cpp/assets"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/cpp"
    ],
    "hooks": [
      {
        "path": "hooks/session_context.py",
        "hosts": [
          "claude",
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [],
      "codex_prefix_rules": []
    }
  }
}
