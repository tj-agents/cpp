{
  "schema_version": 2,
  "scopes": [
    {
      "name": "base",
      "root": ".agents/base",
      "layout": "kind",
      "plugin": "cpp",
      "domain": "cpp"
    },
    {
      "name": "gpp",
      "root": ".agents/gpp",
      "layout": "kind",
      "plugin": "gpp",
      "domain": "cpp"
    },
    {
      "name": "msvc",
      "root": ".agents/msvc",
      "layout": "kind",
      "plugin": "msvc",
      "domain": "cpp"
    },
    {
      "name": "win32",
      "root": ".agents/win32",
      "layout": "kind",
      "plugin": "win32",
      "domain": "cpp"
    }
  ],
  "host_adapter_roots": {
    "codex": ".codex/skills",
    "claude": ".claude/skills"
  },
  "host_manifest_roots": {
    "codex": ".agents/plugins/manifests/codex",
    "claude": ".agents/plugins/manifests/claude"
  },
  "host_hook_sources": {
    "cpp": {
      "codex": ".agents/plugins/manifests/codex/hooks.json",
      "claude": ".agents/plugins/manifests/claude/hooks.json"
    }
  },
  "generated_roots": [
    ".codex/skills",
    ".claude/skills",
    "plugins",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    ".agents/base/INDEX.md",
    ".agents/gpp/INDEX.md",
    ".agents/msvc/INDEX.md",
    ".agents/win32/INDEX.md"
  ],
  "packages": {
    "cpp": {
      "scopes": [
        "base"
      ]
    },
    "gpp": {
      "scopes": [
        "gpp"
      ]
    },
    "msvc": {
      "scopes": [
        "msvc"
      ]
    },
    "win32": {
      "scopes": [
        "win32"
      ]
    }
  },
  "resources": [
    {
      "plugins": [
        "gpp",
        "msvc",
        "win32"
      ],
      "source": ".agents/base/utility/scripts",
      "destination": "resources/base/utility/scripts",
      "text": true
    },
    {
      "plugins": [
        "msvc"
      ],
      "source": ".agents/msvc/utility/scripts",
      "destination": "resources/msvc/utility/scripts",
      "text": true
    },
    {
      "plugins": [
        "gpp"
      ],
      "source": ".agents/gpp/utility/scripts",
      "destination": "resources/gpp/utility/scripts",
      "text": true
    },
    {
      "plugins": [
        "win32"
      ],
      "source": ".agents/win32/utility/scripts",
      "destination": "resources/win32/utility/scripts",
      "text": true
    }
  ],
  "hook_packages": [
    "cpp"
  ],
  "package_root": "plugins",
  "marketplace_outputs": {
    "codex": ".agents/plugins/marketplace.json",
    "claude": ".claude-plugin/marketplace.json"
  },
  "hostAdapterNames": {
    "cpp:build": "cpp-build",
    "cpp:style": "cpp-style",
    "cpp:structure": "cpp-structure",
    "cpp:testing": "cpp-testing",
    "cpp:libraries": "cpp-libraries",
    "cpp:direction": "cpp-direction",
    "cpp:knowledge": "cpp-knowledge",
    "cpp:learning": "cpp-learning",
    "gpp:toolchain": "gpp-toolchain",
    "gpp:scaffold": "gpp-scaffold",
    "msvc:toolchain": "msvc-toolchain",
    "msvc:scaffold": "msvc-scaffold",
    "win32:style": "win32-style",
    "win32:knowledge": "windows-cpp-knowledge",
    "win32:overview": "windows-overview",
    "cpp:domain-design": "cpp-domain-design",
    "cpp:mixins": "cpp-mixins",
    "cpp:explanation": "cpp-explanation",
    "win32:scaffold": "win32-scaffold"
