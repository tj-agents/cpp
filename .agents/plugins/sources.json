{
  "schema_version": 1,
  "scopes": [
    {
      "name": "base",
      "root": ".agents/base",
      "layout": "kind",
      "plugin": "cpp",
      "domain": "cpp"
    },
    {
      "name": "gpp",
      "root": ".agents/gpp",
      "layout": "kind",
      "plugin": "gpp",
      "domain": "cpp"
    },
    {
      "name": "msvc",
      "root": ".agents/msvc",
      "layout": "kind",
      "plugin": "msvc",
      "domain": "cpp"
    },
    {
      "name": "win32",
      "root": ".agents/win32",
      "layout": "kind",
      "plugin": "win32",
      "domain": "cpp"
    }
  ],
  "host_adapter_roots": {
    "agents": ".agents/skills",
    "codex": ".codex/skills",
    "claude": ".claude/skills"
  },
  "host_manifest_roots": {
    "codex": ".agents/plugins/manifests/codex",
    "claude": ".agents/plugins/manifests/claude"
  },
  "generated_roots": [
    ".agents/skills",
    ".codex/skills",
    ".claude/skills",
    "plugins",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    ".agents/base/INDEX.md",
    ".agents/gpp/INDEX.md",
    ".agents/msvc/INDEX.md",
    ".agents/win32/INDEX.md"
  ],
  "packages": {
    "cpp": {
      "scopes": [
        "base"
      ]
    },
    "gpp": {
      "scopes": [
        "gpp"
      ]
    },
    "msvc": {
      "scopes": [
        "msvc"
      ]
    },
    "win32": {
      "scopes": [
        "win32"
      ]
    },
    "base": {
      "scopes": [
        "base"
      ],
      "rewrites": {
        "cpp:": "base:"
      },
      "hookRewrites": {
        "gpp:gpp-toolchain": "gcc:gcc-toolchain",
        "cpp:": "base:",
        "cpp@cpp-agents": "base@cpp-agents",
        "gpp:": "gcc:",
        "gpp@cpp-agents": "gcc@cpp-agents",
        "msvc:": "windows:",
        "msvc@cpp-agents": "windows@cpp-agents",
        "win32:": "windows:",
        "win32@cpp-agents": "windows@cpp-agents"
      }
    },
    "gcc": {
      "scopes": [
        "gpp"
      ],
      "skillAliases": {
        "gpp-toolchain": "gcc-toolchain"
      },
      "rewrites": {
        "cpp:": "base:",
        "gpp:gpp-toolchain": "gcc:gcc-toolchain"
      }
    },
    "windows": {
      "scopes": [
        "msvc",
        "win32"
      ],
      "rewrites": {
        "cpp:": "base:",
        "msvc:": "windows:",
        "win32:": "windows:"
      }
    },
    "cpp-standards": {
      "scopes": [
        "base"
      ],
      "rewrites": {
        "cpp:": "cpp-standards:"
      },
      "hookRewrites": {
        "cpp:": "cpp-standards:",
        "cpp@cpp-agents": "cpp-standards@cpp-agents",
        "gpp:": "gpp-standards:",
        "gpp@cpp-agents": "gpp-standards@cpp-agents",
        "msvc:": "windows:",
        "msvc@cpp-agents": "windows@cpp-agents",
        "win32:": "windows:",
        "win32@cpp-agents": "windows@cpp-agents"
      }
    },
    "gpp-standards": {
      "scopes": [
        "gpp"
      ],
      "rewrites": {
        "cpp:": "cpp-standards:",
        "gpp:": "gpp-standards:"
      }
    }
  },
  "resources": [
    {
      "plugins": [
        "msvc",
        "windows"
      ],
      "source": ".agents/msvc/utility/scripts",
      "destination": "resources/msvc/utility/scripts"
    }
  ],
  "hook_packages": [
    "cpp",
    "base",
    "cpp-standards"
  ]
}
