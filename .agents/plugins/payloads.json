{
  "$comment": "Canonical C++ scopes, package dependencies, hooks, and time-bounded compatibility packages.",
  "description": "Independent C++, G++, MSVC, and Win32 guidance for Claude Code and Codex.",
  "publicPlugins": [
    "cpp",
    "gpp",
    "msvc",
    "win32"
  ],
  "payloads": {
    "cpp": [
      "base"
    ],
    "gpp": [
      "gpp"
    ],
    "msvc": [
      "msvc"
    ],
    "win32": [
      "win32"
    ],
    "base": [
      "base"
    ],
    "gcc": [
      "gpp"
    ],
    "windows": [
      "msvc",
      "win32"
    ],
    "cpp-standards": [
      "base"
    ],
    "gpp-standards": [
      "gpp"
    ]
  },
  "dependencies": {
    "gpp": [
      "cpp"
    ],
    "msvc": [
      "cpp"
    ],
    "win32": [
      "cpp"
    ],
    "gcc": [
      "base"
    ],
    "windows": [
      "base"
    ],
    "gpp-standards": [
      "cpp-standards"
    ]
  },
  "hooks": [
    "cpp",
    "base",
    "cpp-standards"
  ],
  "compatibilityAliases": {
    "base": {
      "replacedBy": "cpp",
      "removeAfter": "2027-03-31",
      "selectorAliases": {
        "base@cpp-agents": "cpp@cpp-agents"
      }
    },
    "gcc": {
      "replacedBy": "gpp",
      "removeAfter": "2027-03-31",
      "skillAliases": {
        "gcc-toolchain": "gpp-toolchain"
      }
    },
    "windows": {
      "replacedBy": [
        "msvc",
        "win32"
      ],
      "removeAfter": "2027-03-31",
      "requiresExplicitSplit": true
    },
    "cpp-standards": {
      "replacedBy": "cpp",
      "removeAfter": "2027-03-31"
    },
    "gpp-standards": {
      "replacedBy": "gpp",
      "removeAfter": "2027-03-31"
    }
  }
}
