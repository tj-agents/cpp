{
  "_comment": [
    "Generated by tj-agents/cpp .agents/gen_skill_routes.py; do not edit by hand.",
    "Toolchain and API selections are independent. Host OS never chooses a compiler.",
    "Every matching technical route fires; no process plugin is required."
  ],
  "kind": "gpp",
  "profile": {
    "toolchain": "gpp",
    "apis": []
  },
  "layers": [
    "cpp",
    "gpp"
  ],
  "routes": [
    {
      "path": "(?i:\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx))$",
      "skills": [
        "cpp:style",
        "cpp:domain-design",
        "cpp:mixins",
        "cpp:structure"
      ],
      "note": "C++ style, data and invariant design, behavior composition, and project structure."
    },
    {
      "path": "(?i:(^|/)(CMakeLists\\.txt|CMakePresets\\.json|[^/]+\\.cmake))$",
      "skills": [
        "cpp:build",
        "cpp:structure",
        "cpp:libraries"
      ]
    },
    {
      "path": "(?i:(^|/)(tests?|test)/.*\\.(c|cc|cpp|cxx|h|hh|hpp|hxx)|(_test|_tests)\\.(c|cc|cpp|cxx))$",
      "skills": [
        "cpp:testing"
      ]
    },
    {
      "path": "(?i:\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx))$|(?i:(^|/)(CMakeLists\\.txt|CMakePresets\\.json|[^/]+\\.cmake))$",
      "skills": [
        "gpp:toolchain"
      ],
      "note": "Explicit G++ toolchain selection."
    }
  ]
}
