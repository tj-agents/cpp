cmake_minimum_required(VERSION 3.28)
project(__PROJECT__ VERSION 0.1.0 LANGUAGES CXX)

if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    message(FATAL_ERROR "This preset requires MSVC. Initialize Developer PowerShell first.")
endif()

add_executable(__PROJECT__ src/main.cpp)
target_compile_features(__PROJECT__ PRIVATE cxx_std___CPP_STANDARD__)
target_compile_options(__PROJECT__ PRIVATE /W4 /permissive- /utf-8 /EHsc)
set_target_properties(__PROJECT__ PROPERTIES
    CXX_EXTENSIONS OFF
    COMPILE_WARNING_AS_ERROR ON
    MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")

include(CTest)
