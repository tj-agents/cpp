cmake_minimum_required(VERSION 3.28)

project(__PROJECT__
    VERSION 0.1.0
    DESCRIPTION "A C++ project"
    LANGUAGES CXX)

if(PROJECT_IS_TOP_LEVEL)
    set(CMAKE_CXX_STANDARD __CPP_STANDARD__)
    set(CMAKE_CXX_STANDARD_REQUIRED ON)
    set(CMAKE_CXX_EXTENSIONS OFF)
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
    include(CTest)

    # `cmake --install` places the executable in a directory already on PATH.
    if(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
        if(CMAKE_HOST_WIN32 AND DEFINED ENV{LOCALAPPDATA})
            set(CMAKE_INSTALL_PREFIX "$ENV{LOCALAPPDATA}/Microsoft/WindowsApps" CACHE PATH "" FORCE)
        elseif(NOT CMAKE_HOST_WIN32 AND DEFINED ENV{HOME})
            set(CMAKE_INSTALL_PREFIX "$ENV{HOME}/.local/bin" CACHE PATH "" FORCE)
        endif()
    endif()
endif()

add_library(__NAMESPACE___warnings INTERFACE)
target_compile_options(__NAMESPACE___warnings INTERFACE
    -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion)

option(__NAMESPACE_UPPER___WARNINGS_AS_ERRORS "Treat compiler warnings as errors" OFF)
if(__NAMESPACE_UPPER___WARNINGS_AS_ERRORS)
    target_compile_options(__NAMESPACE___warnings INTERFACE -Werror)
endif()

add_library(__NAMESPACE___sanitize INTERFACE)
option(__NAMESPACE_UPPER___SANITIZE "Build owned targets with AddressSanitizer and UBSan" OFF)
if(__NAMESPACE_UPPER___SANITIZE)
    target_compile_options(__NAMESPACE___sanitize INTERFACE
        -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(__NAMESPACE___sanitize INTERFACE -fsanitize=address,undefined)
endif()

# No C++20 modules yet. Module scanning adds compiler flags that clangd and
# clang-tidy cannot parse; enable it when the project adopts modules.
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)

add_subdirectory(libs/core)
add_subdirectory(app)

if(PROJECT_IS_TOP_LEVEL AND BUILD_TESTING)
    add_subdirectory(tests)
endif()
