cmake_minimum_required(VERSION 3.28)
project(__PROJECT__ VERSION 0.1.0 LANGUAGES CXX)

if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    message(FATAL_ERROR "This preset requires MSVC. Initialize Developer PowerShell first.")
endif()

if(PROJECT_IS_TOP_LEVEL)
    set(CMAKE_CXX_EXTENSIONS OFF)
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    include(CTest)
endif()

add_library(__NAMESPACE___warnings INTERFACE)
target_compile_features(__NAMESPACE___warnings INTERFACE cxx_std___CPP_STANDARD__)
target_compile_options(__NAMESPACE___warnings INTERFACE /W4 /permissive- /utf-8 /EHsc)

option(__NAMESPACE_UPPER___WARNINGS_AS_ERRORS "Treat compiler warnings as errors" ON)
if(__NAMESPACE_UPPER___WARNINGS_AS_ERRORS)
    set(CMAKE_COMPILE_WARNING_AS_ERROR ON)
endif()

add_subdirectory(libs/core)
add_subdirectory(app)

if(PROJECT_IS_TOP_LEVEL AND BUILD_TESTING)
    add_subdirectory(tests)
endif()
